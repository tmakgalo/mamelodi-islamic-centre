# Get a free key at https://web3forms.com (register with tmakgalo@gmail.com)
# Add the same variable in Vercel: Project → Settings → Environment Variables
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# --- PayFast (online donations) ---
# These are read only by the serverless functions in /api and must NOT start with VITE_,
# otherwise they would be exposed in the browser. Set them in Vercel, not in code.
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
# Must match the passphrase saved in your PayFast account (Settings → Integration).
PAYFAST_PASSPHRASE=your_passphrase
# true = sandbox.payfast.co.za for testing; remove or set false for live payments.
PAYFAST_SANDBOX=true
# Public address of the site, no trailing slash. Used for the return/cancel/notify URLs.
SITE_URL=https://your-domain.example
# Optional: send PayFast's payment confirmation emails here instead of the merchant account email.
DONATION_NOTIFY_EMAIL=
